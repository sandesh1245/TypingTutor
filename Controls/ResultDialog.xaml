<Window x:Class="TypingTutor.Controls.ResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TypingTutor.Controls"
        Title="Exam Performance Scorecard" Height="580" Width="680"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC" WindowStyle="None" AllowsTransparency="True">
    <Border Background="#FFFFFF" CornerRadius="16" BorderBrush="#CBD5E1" BorderThickness="1" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock x:Name="TxtExamTitle" Text="SSC CGL DEST Mock Test Results" Foreground="#0F172A" FontSize="20" FontWeight="Black"/>
                    <TextBlock x:Name="TxtPassageTitle" Text="Passage: Indian Economy &amp; Growth" Foreground="#475569" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Pass / Fail Badge -->
                <Border x:Name="BdrResultBadge" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#16A34A" CornerRadius="8" Padding="14,6">
                    <TextBlock x:Name="TxtResultStatus" Text="QUALIFIED" Foreground="#FFFFFF" FontSize="13" FontWeight="Black"/>
                </Border>
            </Grid>

            <Separator Grid.Row="1" Background="#E2E8F0" Margin="0,16"/>

            <!-- Main Metrics Cards Grid -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top row 3 key cards -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <controls:MetricCard x:Name="CardNetWpm" Grid.Column="0" CardTitle="NET SPEED" Value="42.5" Unit="WPM" Subtitle="Target: 35 WPM" Margin="0,0,6,0"/>
                    <controls:MetricCard x:Name="CardGrossWpm" Grid.Column="1" CardTitle="GROSS SPEED" Value="46.0" Unit="WPM" Subtitle="Keystrokes / 5" Margin="3,0,3,0"/>
                    <controls:MetricCard x:Name="CardAccuracy" Grid.Column="2" CardTitle="ACCURACY" Value="96.2%" Unit="" Subtitle="Target: 95.0%" Margin="6,0,0,0"/>
                </Grid>

                <!-- Second row error breakdown -->
                <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Keystroke &amp; Error Breakdown" Foreground="#0F172A" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>

                        <UniformGrid Grid.Row="1" Columns="4">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Total Keystrokes" Foreground="#64748B" FontSize="11"/>
                                <TextBlock x:Name="TxtTotalKeystrokes" Text="2,300" Foreground="#0F172A" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Substitution Errors" Foreground="#64748B" FontSize="11"/>
                                <TextBlock x:Name="TxtSubErrors" Text="8" Foreground="#DC2626" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Omission Errors" Foreground="#64748B" FontSize="11"/>
                                <TextBlock x:Name="TxtOmErrors" Text="2" Foreground="#D97706" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Backspaces Used" Foreground="#64748B" FontSize="11"/>
                                <TextBlock x:Name="TxtBackspaces" Text="14" Foreground="#0284C7" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- Weak keys summary -->
                <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Recommended Key Practice" Foreground="#0F172A" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtWeakKeysAdvice" Text="You mistyped characters 'P', 'R', and 'Z' most frequently. Try the Specialized Vocabulary Drill to improve muscle memory." Foreground="#475569" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Retake Test" Click="BtnRetake_Click" Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" Padding="18,8" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <Button Content="Done / Close" Click="BtnClose_Click" Background="#0284C7" Foreground="#FFFFFF" BorderBrush="Transparent" Padding="22,8" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
