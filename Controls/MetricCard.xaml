<UserControl x:Class="TypingTutor.Controls.MetricCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="180">
    <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.06"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TxtTitle" Text="NET SPEED" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                <TextBlock x:Name="TxtValue" Text="42.5" Foreground="#0F172A" FontSize="26" FontWeight="Black"/>
                <TextBlock x:Name="TxtUnit" Text="WPM" Foreground="#0284C7" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="6,0,0,4"/>
            </StackPanel>

            <TextBlock x:Name="TxtSubtitle" Grid.Row="2" Text="Target: 35 WPM" Foreground="#94A3B8" FontSize="10"/>
        </Grid>
    </Border>
</UserControl>
