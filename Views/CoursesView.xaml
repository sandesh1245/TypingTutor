<UserControl x:Class="TypingTutor.Views.CoursesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:TypingTutor.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Course Language Selector Header with Round Icon -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Round Icon Badge -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EEF2FF" Width="38" Height="38" CornerRadius="19" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="📘" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TYPING COURSES" Foreground="#0F172A" FontSize="15" FontWeight="Black"/>
                        <TextBlock Text="Guided Touch Typing Curriculum across 10 Indian Languages" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <!-- Middle: Language Selection Dropdown with Round Icon -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#F1F5F9" Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="🌐" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Course Language:" Foreground="#475569" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbCourseLanguage" Width="230" Height="34" SelectionChanged="CmbCourseLanguage_SelectionChanged" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold"/>

                    <!-- Indic IME Active Badge -->
                    <Border x:Name="BdrCourseIndicBadge" Background="#DCFCE7" CornerRadius="12" Padding="10,4" Margin="12,0,0,0" BorderBrush="#86EFAC" BorderThickness="1" Visibility="Collapsed" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌨️ " FontSize="11"/>
                            <TextBlock x:Name="TxtCourseIndicMode" Text="Indic In-App IME: Active" Foreground="#15803D" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Quick Stats Badge -->
                <Border Grid.Column="2" Background="#EEF2FF" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCourseProgress" Text="5 Structured Lessons" Foreground="#4F46E5" FontSize="11" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Body Grid -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Lessons List Panel -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14" Margin="0,0,12,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.04"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="4,0,0,12">
                        <Border Background="#EEF2FF" Width="24" Height="24" CornerRadius="12" Margin="0,0,8,0">
                            <TextBlock Text="📑" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Step-by-Step Curriculum" Foreground="#334155" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ListBox x:Name="LstLessons" Grid.Row="1" SelectionChanged="LstLessons_SelectionChanged" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" CornerRadius="10" Padding="12,10" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#4F46E5" CornerRadius="10" Padding="8,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding LessonNumber, StringFormat='Lesson {0}'}" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="{Binding Category}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" FontFamily="Nirmala UI, Mangal, Segoe UI, Arial" Foreground="#0F172A" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right Interactive Practice Arena -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Lesson Header Info -->
                <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="TxtLessonTitle" Text="Home Row Basics" FontFamily="Nirmala UI, Mangal, Segoe UI, Arial" Foreground="#0F172A" FontSize="18" FontWeight="Black"/>
                            <TextBlock x:Name="TxtLessonDesc" Text="Place fingers on designated home keys." FontFamily="Nirmala UI, Mangal, Segoe UI, Arial" Foreground="#64748B" FontSize="12" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Background="#EEF2FF" CornerRadius="10" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock Text="Finger Guide" Foreground="#4F46E5" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <TextBlock x:Name="TxtFingerGuide" Text="Left Hand / Right Hand" FontFamily="Nirmala UI, Mangal, Segoe UI, Arial" Foreground="#334155" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Practice Text Box -->
                <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="100"/>
                        </Grid.RowDefinitions>

                        <!-- Target Text Display -->
                        <RichTextBox x:Name="RtbPracticeText" Grid.Row="0" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#0F172A" FontSize="21" FontFamily="Nirmala UI, Mangal, Segoe UI, Consolas, Arial"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,6">
                            <Border Background="#E0F2FE" Width="18" Height="18" CornerRadius="9" Margin="0,0,6,0">
                                <TextBlock Text="✍" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0284C7"/>
                            </Border>
                            <TextBlock Text="Type the lesson text below (In-App Indic transliteration active):" Foreground="#475569" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- User Input Box -->
                        <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="12" BorderBrush="#4F46E5" BorderThickness="1.5" Padding="10">
                            <TextBox x:Name="TxtLessonInput" TextChanged="TxtLessonInput_TextChanged" PreviewTextInput="TxtLessonInput_PreviewTextInput" Background="Transparent" BorderThickness="0" Foreground="#0F172A" FontSize="21" FontFamily="Nirmala UI, Mangal, Segoe UI, Consolas, Arial" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Virtual Keyboard -->
                <controls:VirtualKeyboard x:Name="CourseKeyboard" Grid.Row="2" Margin="0,12,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
