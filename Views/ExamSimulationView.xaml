<UserControl x:Class="TypingTutor.Views.ExamSimulationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:TypingTutor.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Exam Preset Selector Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Mock Exam Title & Preset with Round Icon -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#E0F2FE" Width="36" Height="36" CornerRadius="18" Margin="0,0,10,0">
                        <TextBlock Text="🎯" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="MOCK EXAM MODE" Foreground="#0284C7" FontSize="10" FontWeight="Black"/>
                        <TextBlock Text="Official Speed Test" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ComboBox x:Name="CmbExamPreset" Width="210" Height="34" SelectionChanged="CmbExamPreset_SelectionChanged" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Exam mode settings summary pill badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#F1F5F9" CornerRadius="12" Padding="10,4" Margin="4,0" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌫ " Foreground="#64748B" FontSize="11"/>
                            <TextBlock x:Name="TxtBackspaceRuleBadge" Text="Backspace: Allowed" Foreground="#334155" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F1F5F9" CornerRadius="12" Padding="10,4" Margin="4,0" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯 " FontSize="11"/>
                            <TextBlock x:Name="TxtTargetWpmBadge" Text="Target: 35 WPM" Foreground="#334155" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F1F5F9" CornerRadius="12" Padding="10,4" Margin="4,0" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏳ " FontSize="11"/>
                            <TextBlock x:Name="TxtTimeLimitBadge" Text="Time: 15 Mins" Foreground="#334155" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <!-- Indic In-App Keyboard Mode Badge -->
                    <Border x:Name="BdrIndicMode" Background="#DCFCE7" CornerRadius="12" Padding="10,4" Margin="4,0" BorderBrush="#86EFAC" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌨️ " FontSize="11"/>
                            <TextBlock x:Name="TxtIndicMode" Text="Indic IME: Active" Foreground="#15803D" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Passage Selector & Start/Reset controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="CmbPassages" Width="230" Height="34" SelectionChanged="CmbPassages_SelectionChanged" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                    <Button x:Name="BtnFinishTest" Content="Finish Test" Click="BtnFinishTest_Click" Background="#EF4444" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,7" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="16"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Live Score Ticker Bar with High-Contrast Professional Metric Cards -->
        <Border Grid.Row="1" Background="#FFFFFF" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Timer Card -->
                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="0,0,6,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" BlurRadius="6" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" HorizontalAlignment="Left" Background="#FEF3C7" CornerRadius="14" Width="30" Height="30" Margin="0,0,0,6">
                            <TextBlock Text="⏱️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Row="1" x:Name="TxtTimer" Text="15:00" Foreground="#0F172A" FontSize="22" FontWeight="Black"/>
                        <TextBlock Grid.Row="2" Text="Time Remaining" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </Grid>
                </Border>

                <!-- Net WPM Card -->
                <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="4,0,4,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" BlurRadius="6" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" HorizontalAlignment="Left" Background="#E0F2FE" CornerRadius="14" Width="30" Height="30" Margin="0,0,0,6">
                            <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtNetWpm" Text="0.0" Foreground="#0284C7" FontSize="22" FontWeight="Black"/>
                            <TextBlock Text=" WPM" Foreground="#0284C7" FontSize="11" FontWeight="Bold" VerticalAlignment="Bottom" Margin="3,0,0,3"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="Words Per Minute" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </Grid>
                </Border>

                <!-- Gross WPM Card -->
                <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="4,0,4,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" BlurRadius="6" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" HorizontalAlignment="Left" Background="#F1F5F9" CornerRadius="14" Width="30" Height="30" Margin="0,0,0,6">
                            <TextBlock Text="📊" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtGrossWpm" Text="0.0" Foreground="#0F172A" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text=" WPM" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="3,0,0,3"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="Gross Speed" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </Grid>
                </Border>

                <!-- Accuracy Card -->
                <Border Grid.Column="3" Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="4,0,4,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" BlurRadius="6" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" HorizontalAlignment="Left" Background="#DCFCE7" CornerRadius="14" Width="30" Height="30" Margin="0,0,0,6">
                            <TextBlock Text="🎯" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Row="1" x:Name="TxtAccuracy" Text="100%" Foreground="#16A34A" FontSize="22" FontWeight="Black"/>
                        <TextBlock Grid.Row="2" Text="Accuracy Rate" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </Grid>
                </Border>

                <!-- Keystrokes Card -->
                <Border Grid.Column="4" Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="6,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" BlurRadius="6" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" HorizontalAlignment="Left" Background="#F3E8FF" CornerRadius="14" Width="30" Height="30" Margin="0,0,0,6">
                            <TextBlock Text="⌨️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Row="1" x:Name="TxtKeystrokes" Text="0" Foreground="#7C3AED" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Grid.Row="2" Text="Total Keystrokes" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Passage & Typing Area -->
        <Grid Grid.Row="2" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="120"/>
            </Grid.RowDefinitions>

            <!-- Target Passage Display Box -->
            <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="14" BorderBrush="#CBD5E1" BorderThickness="1" Padding="18" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.04"/>
                </Border.Effect>
                <ScrollViewer x:Name="ScrollerPassage" VerticalScrollBarVisibility="Auto">
                    <RichTextBox x:Name="RtbPassage" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#0F172A" FontSize="19" FontFamily="Nirmala UI, Mangal, Segoe UI, Consolas, Arial" IsDocumentEnabled="True"/>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,0,0,6">
                <Border Background="#E0F2FE" Width="18" Height="18" CornerRadius="9" Margin="0,0,6,0">
                    <TextBlock Text="✍" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0284C7"/>
                </Border>
                <TextBlock Text="CANDIDATE TYPING AREA (Start typing below to auto-start timer)" Foreground="#475569" FontSize="11" FontWeight="Bold"/>
            </StackPanel>

            <!-- User Typing Input Box -->
            <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="14" BorderBrush="#0284C7" BorderThickness="2" Padding="12">
                <Border.Effect>
                    <DropShadowEffect Color="#0284C7" BlurRadius="8" ShadowDepth="1" Opacity="0.12"/>
                </Border.Effect>
                <TextBox x:Name="TxtUserInput" TextChanged="TxtUserInput_TextChanged" PreviewKeyDown="TxtUserInput_PreviewKeyDown" PreviewTextInput="TxtUserInput_PreviewTextInput" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Foreground="#0F172A" FontSize="19" FontFamily="Nirmala UI, Mangal, Segoe UI, Consolas, Arial" VerticalContentAlignment="Top"/>
            </Border>
        </Grid>

        <!-- Virtual Keyboard Footer -->
        <controls:VirtualKeyboard x:Name="KeyboardControl" Grid.Row="3" Margin="16,0,16,16"/>
    </Grid>
</UserControl>
