<UserControl x:Class="TypingTutor.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:TypingTutor.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Border Background="#F8FAFC" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header with Round Icon Badge & Candidate Profile -->
            <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18,14" Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.04"/>
                </Border.Effect>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FCE7F3" Width="44" Height="44" CornerRadius="22" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="📊" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ADVANCED PERFORMANCE ANALYTICS" Foreground="#0F172A" FontSize="18" FontWeight="Black"/>
                            <TextBlock Text="Track historical speed progression, accuracy metrics, and weak key heatmaps over time." Foreground="#64748B" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Active User Card & Action -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#F8FAFC" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,5" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0284C7" Offset="0"/>
                                            <GradientStop Color="#1D4ED8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock x:Name="TxtAnalyticsAvatar" Text="ET" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtAnalyticsUserName" Text="Guest Candidate" Foreground="#0F172A" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtAnalyticsUserStatus" Text="User ID: guest" Foreground="#64748B" FontSize="9"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnClearHistory" Content="Clear History" Click="BtnClearHistory_Click" Background="#F8FAFC" Foreground="#64748B" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" FontWeight="Bold" Padding="12,6" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="14"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="BtnAnalyticsSignOut" Content="Sign Out" Click="BtnAnalyticsSignOut_Click" Visibility="Collapsed" Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" FontSize="11" FontWeight="Bold" Padding="12,6" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="14"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Summary Cards Grid -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <controls:MetricCard x:Name="CardBestWpm" Grid.Column="0" CardTitle="BEST NET SPEED" Value="0.0" Unit="WPM" Subtitle="Personal Record" Margin="0,0,6,0"/>
                <controls:MetricCard x:Name="CardAvgWpm" Grid.Column="1" CardTitle="AVERAGE SPEED" Value="0.0" Unit="WPM" Subtitle="Across All Tests" Margin="3,0,3,0"/>
                <controls:MetricCard x:Name="CardAvgAccuracy" Grid.Column="2" CardTitle="AVG ACCURACY" Value="0.0%" Unit="" Subtitle="Target: 95.0%" Margin="3,0,3,0"/>
                <controls:MetricCard x:Name="CardTotalTests" Grid.Column="3" CardTitle="TOTAL MOCK TESTS" Value="0" Unit="TESTS" Subtitle="Attempted" Margin="6,0,0,0"/>
            </Grid>

            <!-- Main Content Area: Left History Table / Right Weak Keys -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Test Attempt History Table -->
                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,0,16,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#E0F2FE" Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0">
                                <TextBlock Text="📜" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Recent Exam Attempt Log" Foreground="#0F172A" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <DataGrid x:Name="DgHistory" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" Foreground="#0F172A" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date / Time" Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm'}" Width="130"/>
                                <DataGridTextColumn Header="Exam Preset" Binding="{Binding ExamPresetName}" Width="150"/>
                                <DataGridTextColumn Header="Passage" Binding="{Binding PassageTitle}" Width="*"/>
                                <DataGridTextColumn Header="Net WPM" Binding="{Binding NetWpm, StringFormat='{}{0:F1}'}" Width="80"/>
                                <DataGridTextColumn Header="Accuracy" Binding="{Binding AccuracyPercent, StringFormat='{}{0:F1}%'}" Width="80"/>
                                <DataGridCheckBoxColumn Header="Passed" Binding="{Binding PassedExam}" Width="65"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Weak Key Heatmap Panel -->
                <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#FEE2E2" Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0">
                                <TextBlock Text="🎯" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Weak Key Mistake Frequency" Foreground="#0F172A" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ListBox x:Name="LstWeakKeys" Grid.Row="1" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" CornerRadius="10" Padding="12,8" Margin="0,0,0,6" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Round Icon Key Badge -->
                                                <Border Background="#EF4444" CornerRadius="15" Width="30" Height="30" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding KeyLabel}" Foreground="#FFFFFF" FontSize="13" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Mistyped Key" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <Border Background="#FEE2E2" CornerRadius="10" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ErrorCountLabel}" Foreground="#DC2626" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
