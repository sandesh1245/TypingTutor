<Window x:Class="TypingTutor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TypingTutor"
        mc:Ignorable="d"
        Title="ExamTyping - Professional Typing Tutor &amp; Examination Suite" Height="800" Width="1280"
        MinHeight="720" MinWidth="1050"
        Icon="Store/Assets/app.ico"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC">

    <Window.Resources>
        <!-- Modern Pill Navigation Button Style -->
        <Style x:Key="ModernNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="BdrRoot" Background="Transparent" CornerRadius="12" Padding="10,8" Margin="0,3">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BdrRoot" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BdrRoot" Property="Background" Value="#E0F2FE"/>
                                <Setter TargetName="BdrRoot" Property="BorderBrush" Value="#0284C7"/>
                                <Setter TargetName="BdrRoot" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round Action Button Style -->
        <Style x:Key="RoundActionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BdrBtn" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BdrBtn" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BdrBtn" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainRootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Top Bar -->
        <Border x:Name="BdrHeader" Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <!-- Brand Title with Round Icon Badge -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Circular Gradient Logo Icon -->
                    <Border Width="38" Height="38" CornerRadius="19" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0284C7" Offset="0"/>
                                <GradientStop Color="#6366F1" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#0284C7" BlurRadius="12" Opacity="0.3" ShadowDepth="2"/>
                        </Border.Effect>
                        <TextBlock Text="⌨" Foreground="#FFFFFF" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ExamTyping" Foreground="#0F172A" FontSize="16" FontWeight="Black" VerticalAlignment="Center"/>
                            <Border Background="#E0F2FE" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PRO SUITE" Foreground="#0284C7" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Government Typing Examination Platform" Foreground="#64748B" FontSize="11" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status & Theme & Cloud Sync Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Light / Dark Theme Toggle Button with Round Icon -->
                    <Button x:Name="BtnToggleTheme" Click="BtnToggleTheme_Click" Style="{StaticResource RoundActionButtonStyle}" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#FEF3C7" Margin="0,0,8,0">
                                <TextBlock x:Name="TxtThemeIcon" Text="☀️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtThemeStatus" Text="Light Mode" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Sync Status Button with Round Icon -->
                    <Button x:Name="BtnSyncCloud" Click="BtnSyncCloud_Click" Style="{StaticResource RoundActionButtonStyle}" Background="#F8FAFC" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#E0F2FE" Margin="0,0,8,0">
                                <TextBlock Text="☁" Foreground="#0284C7" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtSyncStatus" Text="Offline Ready" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Pro License Badge (Pill with Round Icon) -->
                    <Border x:Name="BdrProBadge" Background="#E0F2FE" CornerRadius="16" Padding="12,5" BorderBrush="#BAE6FD" BorderThickness="1" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="18" Height="18" CornerRadius="9" Background="#0284C7" Margin="0,0,6,0">
                                <TextBlock Text="★" Foreground="#FFFFFF" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtProBadge" Text="FREE VERSION" Foreground="#0284C7" FontSize="10" FontWeight="Black" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- User Profile Button with Round Avatar -->
                    <Button x:Name="BtnUserProfile" Click="BtnUserProfile_Click" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="4,3,10,3" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="18"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0284C7" Offset="0"/>
                                        <GradientStop Color="#1D4ED8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock x:Name="TxtUserAvatarInitials" Text="ET" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,4,0">
                                <TextBlock x:Name="TxtUserDisplayName" Text="Guest Candidate" Foreground="#0F172A" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtUserStatusLabel" Text="Click to Login / Register" Foreground="#64748B" FontSize="9"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Sign Out Button (Visible when logged in) -->
                    <Button x:Name="BtnSignOut" Click="BtnSignOut_Click" Visibility="Collapsed" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" Padding="10,5" Margin="8,0,0,0" Cursor="Hand" ToolTip="Sign out of your account">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="16"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="20" Height="20" CornerRadius="10" Background="#FEE2E2" Margin="0,0,6,0">
                                <TextBlock Text="🚪" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Sign Out" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body Grid: Sidebar + View Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Border x:Name="BdrSidebar" Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="14,16">
                <DockPanel>
                    <!-- Bottom Version Footer -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="4,0,4,8">
                        <Separator Background="#E2E8F0" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="16" Height="16" CornerRadius="8" Background="#10B981" Margin="0,0,6,0">
                                <TextBlock Text="✓" Foreground="#FFFFFF" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="v2.5.0 Exam Suite" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="SSC • MPSC • High Court • Railways" Foreground="#94A3B8" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Navigation Items List with Circular Icon Badges -->
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="EXAMINATION &amp; PRACTICE" Foreground="#94A3B8" FontSize="9" FontWeight="Black" Margin="10,0,0,8"/>

                        <!-- Mock Exam Simulator -->
                        <RadioButton x:Name="NavExam" IsChecked="True" Checked="Nav_Checked" Style="{StaticResource ModernNavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#E0F2FE" Margin="0,0,10,0">
                                    <TextBlock Text="🎯" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Mock Exam Simulator" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="Official Test Environment" Foreground="#64748B" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <!-- Typing Courses -->
                        <RadioButton x:Name="NavCourses" Checked="Nav_Checked" Style="{StaticResource ModernNavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#EEF2FF" Margin="0,0,10,0">
                                    <TextBlock Text="📘" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Typing Courses" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="Guided Finger Drills" Foreground="#64748B" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <!-- Vocabulary Builder -->
                        <RadioButton x:Name="NavVocab" Checked="Nav_Checked" Style="{StaticResource ModernNavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#FEF3C7" Margin="0,0,10,0">
                                    <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Vocabulary Builder" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="High-Frequency Words" Foreground="#64748B" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <!-- Arcade Typing Games -->
                        <RadioButton x:Name="NavGames" Checked="Nav_Checked" Style="{StaticResource ModernNavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#F3E8FF" Margin="0,0,10,0">
                                    <TextBlock Text="🎮" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Arcade Defense" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="Meteor Typer Reflexes" Foreground="#64748B" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <TextBlock Text="CATALOG &amp; METRICS" Foreground="#94A3B8" FontSize="9" FontWeight="Black" Margin="10,16,0,8"/>

                        <!-- 1000+ Passage Catalog -->
                        <RadioButton x:Name="NavCatalog" Checked="Nav_Checked" Style="{StaticResource ModernNavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#DCFCE7" Margin="0,0,10,0">
                                    <TextBlock Text="📚" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Passage Catalog" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="1,000+ Official Tests" Foreground="#64748B" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <!-- Performance Analytics -->
                        <RadioButton x:Name="NavAnalytics" Checked="Nav_Checked" Style="{StaticResource ModernNavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#FFE4E6" Margin="0,0,10,0">
                                    <TextBlock Text="📊" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Analytics &amp; Scores" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="WPM &amp; Accuracy Trends" Foreground="#64748B" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <TextBlock Text="MEMBERSHIP" Foreground="#94A3B8" FontSize="9" FontWeight="Black" Margin="10,16,0,8"/>

                        <!-- Upgrade to Pro -->
                        <RadioButton x:Name="NavPro" Checked="Nav_Checked" Style="{StaticResource ModernNavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#FEF9C3" Margin="0,0,10,0">
                                    <TextBlock Text="⭐" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Upgrade to Pro" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="Unlimited Tests &amp; AI" Foreground="#64748B" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Dynamic View Host Container -->
            <ContentControl x:Name="ViewHost" Grid.Column="1"/>
        </Grid>

        <!-- Authentication (Login / Register / Skip) Modal Overlay -->
        <Border x:Name="BdrAuthModal" Grid.Row="0" Grid.RowSpan="2" Background="#990F172A" Visibility="Collapsed">
            <Border Background="#FFFFFF" CornerRadius="20" BorderBrush="#CBD5E1" BorderThickness="1" Padding="28,24" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="4" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Modal Header -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#E0F2FE" Width="44" Height="44" CornerRadius="22" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="🔐" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtAuthModalTitle" Text="Account Authentication" Foreground="#0F172A" FontSize="18" FontWeight="Black"/>
                                <TextBlock Text="Store your typing exam attempts, speed progression &amp; history" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Click="BtnCloseAuthModal_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="16" FontWeight="Bold" Content="✕" Cursor="Hand" Padding="6"/>
                    </Grid>

                    <!-- Active User Signed-In Info & Sign Out Button inside Modal -->
                    <Border x:Name="PanelActiveUserSignOut" Visibility="Collapsed" Background="#F0FDF4" CornerRadius="12" BorderBrush="#BBF7D0" BorderThickness="1" Padding="14,10" Margin="0,0,0,14">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="30" Height="30" CornerRadius="15" Background="#DCFCE7" Margin="0,0,10,0">
                                    <TextBlock Text="✓" Foreground="#15803D" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtModalActiveUser" Text="Signed in as: Candidate" Foreground="#0F172A" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Active session • Personal history enabled" Foreground="#64748B" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Content="Sign Out" Click="BtnSignOut_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" Padding="12,5" FontWeight="Bold" FontSize="11" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="12"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Tab Switch: Sign In vs Create Account -->
                    <Border Background="#F1F5F9" CornerRadius="14" Padding="3" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RadTabLogin" Content="Sign In" IsChecked="True" Checked="AuthTab_Checked" Style="{StaticResource ModernNavButtonStyle}" HorizontalAlignment="Stretch" Margin="0"/>
                            <RadioButton x:Name="RadTabRegister" Grid.Column="1" Content="Create Account" Checked="AuthTab_Checked" Style="{StaticResource ModernNavButtonStyle}" HorizontalAlignment="Stretch" Margin="4,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Error Alert Banner -->
                    <Border x:Name="BdrAuthError" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️ " FontSize="12"/>
                            <TextBlock x:Name="TxtAuthError" Text="Error message" Foreground="#DC2626" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Success Alert Banner -->
                    <Border x:Name="BdrAuthSuccess" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✅ " FontSize="12"/>
                            <TextBlock x:Name="TxtAuthSuccess" Text="Success message" Foreground="#16A34A" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Full Name (Only for Registration) -->
                    <StackPanel x:Name="PanelAuthDisplayName" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock Text="Full Name / Candidate Name:" Foreground="#334155" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtAuthDisplayName" Height="38" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="10,6" FontSize="12" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- User ID / Username -->
                    <TextBlock Text="User ID / Username:" Foreground="#334155" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtAuthUserId" Height="38" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="10,6" FontSize="12" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

                    <!-- Password -->
                    <TextBlock Text="Password:" Foreground="#334155" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PbAuthPassword" Height="38" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="10,6" FontSize="12" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

                    <!-- Confirm Password (Only for Registration) -->
                    <StackPanel x:Name="PanelAuthConfirmPassword" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock Text="Confirm Password:" Foreground="#334155" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="PbAuthConfirmPassword" Height="38" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="10,6" FontSize="12" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Submit Action Button -->
                    <Button x:Name="BtnAuthSubmit" Content="Sign In to Account ▶" Click="BtnAuthSubmit_Click" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Padding="0,11" BorderThickness="0" Margin="0,6,0,10" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="16"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Divider / Or -->
                    <Grid Margin="0,4,0,10">
                        <Separator Background="#E2E8F0"/>
                        <TextBlock Text="OR" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" Background="#FFFFFF" HorizontalAlignment="Center" Padding="8,0"/>
                    </Grid>

                    <!-- Skip / Continue as Guest Button -->
                    <Button x:Name="BtnAuthSkip" Click="BtnAuthSkip_Click" Content="Skip / Continue as Guest (No Login Required) ▶" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="Bold" FontSize="12" Padding="0,10" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="16"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
