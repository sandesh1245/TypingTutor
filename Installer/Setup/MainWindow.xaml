<Window x:Class="TypingTutorSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExamTyping Tutor - Setup Wizard" Height="480" Width="640"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8FAFC" FontFamily="Segoe UI">
    <Grid>
        <Border Margin="24" Background="#FFFFFF" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="2" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header with Circular Gradient Icon -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="24" Margin="0,0,14,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0284C7" Offset="0"/>
                                    <GradientStop Color="#4F46E5" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="⌨" Foreground="#FFFFFF" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ExamTyping Tutor Setup" Foreground="#0F172A" FontSize="20" FontWeight="Black"/>
                            <TextBlock Text="Professional Typing Tutor &amp; Examination Suite v2.5.0" Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#DCFCE7" CornerRadius="12" Padding="12,5">
                        <TextBlock Text="Official Edition" Foreground="#15803D" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </Grid>

                <Separator Grid.Row="1" Background="#E2E8F0" Margin="0,0,0,18"/>

                <!-- Main Setup Configuration Panel -->
                <StackPanel Grid.Row="2" x:Name="PanelSetupConfig">
                    <TextBlock Text="Installation Folder:" Foreground="#334155" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtInstallPath" Height="36" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="10,6" FontSize="12" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Browse..." Click="BtnBrowse_Click" Height="36" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Padding="14,0" FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <TextBlock Text="Shortcuts &amp; Preferences:" Foreground="#334155" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkDesktopShortcut" Content="Create Desktop Shortcut" IsChecked="True" FontSize="12" Foreground="#0F172A" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkStartMenuShortcut" Content="Create Start Menu Shortcut &amp; Register in Windows" IsChecked="True" FontSize="12" Foreground="#0F172A" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkLaunchAfterInstall" Content="Launch ExamTyping Tutor when installation completes" IsChecked="True" FontSize="12" Foreground="#0F172A" Margin="0,0,0,16"/>

                    <!-- Progress Bar (Visible during install) -->
                    <StackPanel x:Name="PanelProgress" Visibility="Collapsed">
                        <ProgressBar x:Name="PbInstallProgress" Height="8" IsIndeterminate="True" Foreground="#0284C7" Background="#E2E8F0" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtStatus" Text="Extracting application files..." Foreground="#64748B" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Completion Success Panel -->
                <StackPanel Grid.Row="2" x:Name="PanelCompletion" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="28" Background="#DCFCE7" Margin="0,0,0,14" HorizontalAlignment="Center">
                        <TextBlock Text="✓" Foreground="#15803D" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Installation Completed Successfully!" Foreground="#0F172A" FontSize="18" FontWeight="Black" HorizontalAlignment="Center"/>
                    <TextBlock Text="ExamTyping Tutor has been installed and is ready to use." Foreground="#64748B" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Footer Action Buttons -->
                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click" Background="#F1F5F9" Foreground="#64748B" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" FontSize="12" Padding="18,8" Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="14"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="BtnInstall" Content="Install Now ▶" Click="BtnInstall_Click" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Padding="22,8" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="14"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="BtnFinish" Content="Finish &amp; Launch ▶" Click="BtnFinish_Click" Background="#16A34A" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Padding="22,8" BorderThickness="0" Visibility="Collapsed">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="14"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
